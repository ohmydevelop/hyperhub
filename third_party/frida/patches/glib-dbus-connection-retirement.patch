+/* Called from any thread with the connection lock held. Returns TRUE only
+ * for the first transition. Pending calls must complete even when disposal
+ * suppresses further worker callbacks.
+ */
+static gboolean
+set_closed_unlocked (GDBusConnection *connection)
+{
+  guint old_atomic_flags;
+
+  CONNECTION_ENSURE_LOCK (connection);
+
+  old_atomic_flags = g_atomic_int_or (&connection->atomic_flags, FLAG_CLOSED);
+  if (old_atomic_flags & FLAG_CLOSED)
+    return FALSE;
+
+  g_hash_table_foreach_remove (connection->map_method_serial_to_task, cancel_method_on_close, NULL);
+  return TRUE;
+}
