+#ifdef HAVE_LINUX
+# include <pthread.h>
+# ifndef G_ATOMIC_LOCK_FREE
+#  error Linux recovery admission requires lock-free 32-bit GLib atomics
+# endif
+
+/* Native admission survives Environment._deinit() and subsequent Runner
+ * instances. No allocation, GLib lifecycle service, or fork-inherited mutex.
+ * Positive state is (token << 1) | claimed; negative states are local only.
+ * Tokens are never reused within this loaded image, including across Runners. */
+static gint frida_recovery_sequence = 0;
+static gint frida_recovery_admission = 0;
+static gint frida_recovery_resident = 0;
+
+/* Regression targets may export this exact weak symbol to exercise the
+ * controller-loss lifecycle. Ordinary applications do not export it, so
+ * their global namespace leaves this branch disabled. */
+extern gint hyperhub_frida_regression_disconnect_before_prepare_v1 (void)
+    __attribute__ ((weak));
+
+gboolean
+_frida_agent_regression_disconnect_before_prepare (void)
+{
+  if (hyperhub_frida_regression_disconnect_before_prepare_v1 == NULL)
+    return FALSE;
+  return hyperhub_frida_regression_disconnect_before_prepare_v1 () != 0;
+}
+
+void
+_frida_agent_entry_pin_resident (void)
+{
+  /* A later fresh Runner cannot prove that an old loader has disappeared. */
+  g_atomic_int_set (&frida_recovery_resident, 1);
+}
+
+gboolean
+_frida_agent_entry_is_resident (void)
+{
+  return g_atomic_int_get (&frida_recovery_resident) != 0;
+}
+
+gboolean
+_frida_agent_entry_begin_initial (void)
+{
+  return g_atomic_int_compare_and_exchange (&frida_recovery_admission, 0, -1);
+}
+
+guint
+_frida_agent_entry_begin_recovery (void)
+{
+  gint previous;
+
+  do
+  {
+    previous = g_atomic_int_get (&frida_recovery_sequence);
+    if (previous == G_MAXINT / 2)
+    {
+      /* Exhaustion refuses all remote launches; local-only cycles still let
+       * the native application proceed without reusing a wire token. */
+      g_atomic_int_set (&frida_recovery_admission, -4);
+      return 0;
+    }
+  }
+  while (!g_atomic_int_compare_and_exchange (&frida_recovery_sequence,
+      previous, previous + 1));
+
+  g_atomic_int_set (&frida_recovery_admission, (previous + 1) << 1);
+  return previous + 1;
+}
+
+gboolean
+_frida_agent_entry_claim (guint token)
+{
+  if (token == 0)
+    return g_atomic_int_compare_and_exchange (&frida_recovery_admission, -4, -3);
+  if (token > G_MAXINT / 2)
+    return FALSE;
+  return g_atomic_int_compare_and_exchange (&frida_recovery_admission,
+      token << 1, (token << 1) | 1);
+}
+
+void
+_frida_agent_entry_begin_retirement (void)
+{
+  g_atomic_int_set (&frida_recovery_admission, -2);
+}
+
+void
+_frida_agent_entry_finish_retirement (void)
+{
+  g_atomic_int_set (&frida_recovery_admission, 0);
+}
+
+static void *
+frida_agent_local_recovery_worker (void * data)
+{
+  (void) data;
+  if (!_frida_agent_run_local_recovery ())
+    pthread_detach (pthread_self ());
+  return NULL;
+}
+
+gint
+_frida_agent_start_local_recovery (gpointer * thread)
+{
+  pthread_t worker;
+  gint result = pthread_create (&worker, NULL, frida_agent_local_recovery_worker, NULL);
+  if (result == 0)
+    *thread = (gpointer) worker;
+  return result;
+}
+#endif
