  },
  {
    "name": "set_default_route",
    "description": "Set the built-in fallback route behavior.",
    "triggers": [
      "default route",
      "fallback route",
      "默认路由"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the default route is enabled"
        },
        "deny": {
          "type": "boolean",
          "description": "Deny unmatched traffic when true, pass when false"
        }
      },
      "required": [
