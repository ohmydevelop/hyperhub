[
  {
    "name": "set_environment_variable",
    "description": "Create or update one environment variable. The name is the identifier after environment variable or 环境变量; the value is exact and may be secret.",
    "triggers": [
      "set environment variable",
      "add environment variable",
      "添加环境变量",
      "设置环境变量"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Exact variable name, for example API_KEY"
        },
        "value": {
          "type": "string",
          "description": "Exact value, including secrets"
        }
      },
      "required": [
        "name",
        "value"
      ]
    }
  },
  {
    "name": "delete_environment_variable",
    "description": "Delete one environment variable by its exact name.",
    "triggers": [
      "delete environment variable",
      "remove env",
      "删除环境变量"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Exact variable name"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
    "name": "set_bearer_credential",
    "description": "Create or update one HTTP Bearer token credential. credential_id is the identifier after credential or 凭证, not the word credential itself.",
    "triggers": [
      "bearer credential",
      "bearer token",
      "Bearer 凭证",
      "令牌凭证"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "credential_id": {
          "type": "string",
          "description": "Credential identifier, for example devboard-api-bearer"
        },
        "token": {
          "type": "string",
          "description": "Exact Bearer token"
        }
      },
      "required": [
        "credential_id",
        "token"
      ]
    }
  },
  {
