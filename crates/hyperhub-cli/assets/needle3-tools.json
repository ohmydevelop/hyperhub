        "mode"
      ]
    }
  },
  {
    "name": "set_listener",
    "description": "Set local SOCKS listener address or pending session lifetime.",
    "triggers": [
      "listener",
      "socks listen",
      "监听地址",
      "会话超时"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "socks_listen": {
          "type": "string",
          "description": "host:port, for example 127.0.0.1:18444"
        },
        "pending_session_ttl_secs": {
          "type": "integer",
          "description": "Pending session lifetime in seconds"
        }
      }
    }
  },
  {
    "name": "set_audit_policy",
    "description": "Set connection audit retention and allowed HTTP headers.",
    "triggers": [
      "audit policy",
      "audit retention",
      "审计保留",
      "审计请求头"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "retention_days": {
          "type": "integer",
          "description": "Number of retention days"
        },
        "connections": {
          "type": "boolean",
          "description": "Record connection audit events"
        },
        "header_allowlist": {
          "type": "string",
          "description": "Comma-separated HTTP header names"
        }
      }
    }
  },
  {
    "name": "set_upstream_proxy",
    "description": "Create or update an upstream SOCKS5 or HTTP CONNECT proxy.",
    "triggers": [
      "upstream proxy",
      "socks5 proxy",
      "http connect proxy",
      "上游代理"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "upstream_id": {
          "type": "string",
          "description": "Upstream identifier"
        },
        "proxy_type": {
          "type": "string",
          "description": "Proxy type",
          "enum": [
            "socks5",
            "http_connect"
          ]
        },
        "address": {
          "type": "string",
          "description": "Proxy host:port"
        },
        "username": {
          "type": "string",
          "description": "Optional proxy username"
        },
        "password": {
          "type": "string",
          "description": "Optional proxy password"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Connect timeout milliseconds"
        }
      },
      "required": [
        "upstream_id",
        "proxy_type",
        "address"
      ]
    }
  },
  {
    "name": "set_firewall_policy",
    "description": "Enable or disable network firewall and set default/error actions.",
    "triggers": [
      "firewall policy",
      "network policy",
      "防火墙策略",
      "网络策略"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether firewall enforcement is enabled"
        },
        "default_action": {
          "type": "string",
          "description": "Default action",
          "enum": [
            "pass",
            "deny"
          ]
        },
        "error_action": {
          "type": "string",
          "description": "Action on evaluation error",
          "enum": [
            "pass",
            "deny"
          ]
        }
      },
      "required": [
        "enabled",
        "default_action",
        "error_action"
      ]
    }
  },
  {
    "name": "set_firewall_rule",
    "description": "Create or update one network firewall rule for a target and optional port.",
    "triggers": [
      "firewall rule",
      "network rule",
      "防火墙规则",
      "网络规则"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "description": "Rule identifier"
        },
        "target": {
          "type": "string",
          "description": "Hostname, URL, IP or CIDR"
        },
        "port": {
          "type": "integer",
          "description": "Optional destination port"
        },
        "action": {
          "type": "string",
          "description": "Rule action",
          "enum": [
            "pass",
            "deny"
          ]
        },
        "priority": {
          "type": "integer",
          "description": "Higher priority runs first"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether rule is enabled"
        }
      },
      "required": [
        "rule_id",
        "target",
        "action"
      ]
    }
  },
