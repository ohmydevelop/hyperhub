  {
    "name": "set_route",
    "description": "Create or update an unauthenticated route matching a URL, hostname, IP or CIDR target.",
    "triggers": [
      "add route",
      "set route",
      "添加路由",
      "设置路由"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "description": "Route identifier after route or 路由"
        },
        "target": {
          "type": "string",
          "description": "URL, hostname, IP or CIDR target"
        }
      },
      "required": [
        "route_id",
        "target"
      ]
    }
  },
  {
    "name": "set_authenticated_route",
    "description": "Create or update a route and attach an existing credential. Use this whenever the user names a credential for a route.",
    "triggers": [
      "route with credential",
      "authenticated route",
      "认证路由",
      "使用凭证的路由",
      "带凭证路由"
    ],
    "parameters": {
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "description": "Route identifier after route or 路由"
        },
        "target": {
          "type": "string",
          "description": "URL, hostname, IP or CIDR target"
        },
        "credential_id": {
          "type": "string",
          "description": "Existing credential identifier after credential or 凭证"
        }
      },
      "required": [
        "route_id",
        "target",
        "credential_id"
      ]
    }
  },
  {
    "name": "delete_route",
